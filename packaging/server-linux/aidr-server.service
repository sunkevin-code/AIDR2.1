[Unit]
Description=AIDR Unified Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aidr
Group=aidr
EnvironmentFile=/etc/aidr/server.env
WorkingDirectory=/opt/aidr-server
ExecStart=/usr/bin/node /opt/aidr-server/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aidr-server

[Install]
WantedBy=multi-user.target
