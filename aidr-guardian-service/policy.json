  "port": 8787,
  "sessionPolicy": {
    "taskId": "aidr-local-web-guardian",
    "ttlMinutes": 120,
    "allowedWritePaths": [
      "C:\\Users\\OseasyVM\\Documents\\AIDR\\architecture\\**",
      "C:\\Users\\OseasyVM\\Documents\\AIDR\\demo\\**",
